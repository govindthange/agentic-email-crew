<agent-config>

  <categories>
    <!-- Values are the exact strings that appear in the email `category` field -->
    <category name="client"  values="^AB,^ACL,^AU,^BB,^CI,^CSB,^CSFB,^CUB,^ESFB,^FB,^IDFC,^JSFB,^KMB,^Krntk,^KVB,^SB,^SIB,^UB,^UBS,^YB" />
    <category name="project" values="apy,asba,cba,ipo,logistics,pm" />
    <category name="team"    values="sales,accounts,invoice,hr" />
  </categories>

  <settings>
    <setting name="archiveDir"         value="./data/archives" />
    <setting name="outputDir"          value="./data" />
    <!-- 
      dedupeThreshold: Sets the cosine similarity limit (0.0 to 1.0) for clustering emails.
      Usage: Used by the EmailClusteringTool to determine if two emails belong to the same topic.
      Mechanism: 1.0 is identical, higher values result in more tight/granular clusters, 
                 lower values combine more varied emails into the same group. 
    -->
    <setting name="dedupeThreshold"    value="0.82" />
    <!-- Active profile selection: 'small' or 'large' -->
    <setting name="modelProfile"       value="small" />
    <setting name="ollamaBaseUrl"      value="http://ollama:11434" />
    <setting name="escalationKeywords" value="urgent,escalate,blocker,critical,overdue,SLA,deadline,penalty,invoice,PO,proposal" />
    <setting name="emailBodyLimit"     value="1000" />
    <setting name="toolOutputLimit"    value="50000" />
    <setting name="fileReadLimit"      value="120000" />
    <setting name="summaryLogic"       value="llm-local-mini" />
    <setting name="agentExecutionMode" value="sequential" />
  </settings>

  <profiles>
    <profile name="small"  heavy="llama3.1:8b"      light="mistral" />
    <profile name="medium" heavy="mistral-nemo:latest" light="mistral" />
    <profile name="large"  heavy="qwen2.5:32b"      light="mistral-nemo" />
  </profiles>

</agent-config>
